# --- Runtime data: personal calibration, enrolled bottles, logs, model weights ---
# Everything under data/ is generated on the machine that runs the arm. Only the README
# and the example files are versioned.
/data/*
!/data/README.md
!/data/examples/

# --- Per-machine overrides for the WSL scripts (see scripts/wsl/env.sh) ---
/scripts/wsl/local.sh

# --- Desktop teleop runtime data (recorded paths, session log) ---
/teleop/paths/
/teleop/calibration_log.jsonl

# --- Scratch ---
*.log
*.tmp
