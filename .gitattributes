# Normalise line endings in the repository; check out with LF everywhere except Windows scripts.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.mp4  binary
*.webm binary
*.docx binary
*.pptx binary
*.odt  binary
*.pdf  binary
*.npz  binary
*.npy  binary
*.pt   binary
*.task binary
*.tflite binary

# Large generated/CAD text files: keep them out of diffs
*.dae -diff linguist-generated
